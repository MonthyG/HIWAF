{
  "admin": {
    "listen": "127.0.0.1:2019"
  },
  "apps": {
    "http": {
      "http_port": 80,
      "https_port": 443,
      "servers": {
        "waf": {
          "automatic_https": {
            "skip_certificates": [
              "c.com"
            ]
          },
          "errors": {
            "routes": [
              {
                "handle": [
                  {
                    "body": "<!doctype html><html><head><meta charset=\"utf-8\"><title>Request blocked</title></head><body><h1>Request blocked</h1><p>Your request was blocked by the web application firewall.</p><p>Event ID: {http.error.id}</p></body></html>",
                    "handler": "static_response",
                    "headers": {
                      "Content-Type": [
                        "text/html; charset=utf-8"
                      ]
                    },
                    "status_code": "{http.error.status_code}"
                  }
                ],
                "match": [
                  {
                    "host": [
                      "c.com"
                    ]
                  }
                ]
              }
            ]
          },
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "headers": {
                            "request": {
                              "delete": [
                                "X-Hi-Waf-Tx"
                              ]
                            }
                          },
                          "upstreams": [
                            {
                              "dial": "10.0.0.3:80"
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "vars": {
                            "{http.vars.hi_skip}": [
                              "true"
                            ]
                          }
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "handle": [
                        {
                          "handler": "hi_ratelimit",
                          "site_id": "s_cccccccccccc",
                          "attack": {
                            "requests": 10,
                            "window_sec": 60,
                            "ban_sec": 1800
                          },
                          "error": {
                            "requests": 50,
                            "window_sec": 60,
                            "ban_sec": 600
                          }
                        },
                        {
                          "directives": "Include @coraza.conf-recommended\nInclude @crs-setup.conf.example\nSecAction \"id:900000,phase:1,pass,nolog,setvar:tx.blocking_paranoia_level=1\"\nSecAction \"id:900110,phase:1,pass,nolog,setvar:tx.inbound_anomaly_score_threshold=5,setvar:tx.outbound_anomaly_score_threshold=4\"\nInclude @owasp_crs/*.conf\nSecRuleEngine On\nSecResponseBodyAccess Off\nSecRuleRemoveById 950000-956999\n",
                          "handler": "waf",
                          "load_owasp_crs": true,
                          "tx_id_req_header": "X-Hi-Waf-Tx"
                        },
                        {
                          "handler": "reverse_proxy",
                          "headers": {
                            "request": {
                              "delete": [
                                "X-Hi-Waf-Tx"
                              ]
                            }
                          },
                          "upstreams": [
                            {
                              "dial": "10.0.0.3:80"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "c.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "unknown site",
                  "handler": "static_response",
                  "status_code": 404
                }
              ]
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "module": "internal"
              }
            ]
          }
        ]
      },
      "certificates": {
        "load_pem": [
          {
            "certificate": "CERT",
            "key": "KEY",
            "tags": [
              "s_cccccccccccc"
            ]
          }
        ]
      }
    }
  },
  "logging": {
    "logs": {
      "default": {
        "exclude": [
          "http.handlers.waf",
          "http.handlers.hi_access",
          "http.handlers.hi_ratelimit",
          "http.handlers.hi_challenge"
        ]
      },
      "hi_events": {
        "encoder": {
          "format": "json"
        },
        "include": [
          "http.handlers.waf",
          "http.handlers.hi_access",
          "http.handlers.hi_ratelimit",
          "http.handlers.hi_challenge"
        ],
        "writer": {
          "filename": "/var/log/hi-waf/events.log",
          "output": "file",
          "roll_size_mb": 100
        }
      }
    }
  }
}
