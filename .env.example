# Copy to .env next to compose.yaml (docker compose reads it). scripts/install.sh takes
# the same names from the environment: sudo HIWAF_DATA=/srv/hiwaf ./scripts/install.sh
# Everything else (sites, ports, TLS, users) lives in /data/manager.json and the database.

# Host folder mounted as /data in both containers: manager.json, the database,
# Caddy's certificates and the autosaved engine config.
HIWAF_DATA=/data/hiwaf # default: /data/hiwaf

# Port of the manager's API + console (HTTPS, self-signed). install.sh writes it into
# manager.json on the first install; change it there afterwards.
HIWAF_CONSOLE_PORT=9443 # default: 9443
